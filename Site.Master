<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="CodeCrafters_Major_Project_Website.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">The Regal Inn Hotel</asp:ContentPlaceHolder></title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link href="~/css/site-theme.css" runat="server" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form runat="server">
        <!-- ================= NAVBAR ================= -->
        <nav class="navbar-regal" id="regalNavbar">
            <a class="brand" href="~/Default.aspx" runat="server">The Regal Inn Hotel</a>
            <ul class="nav-links">
                <li><a href="~/Default.aspx" runat="server">Home</a></li>
                <li><a href="~/About.aspx" runat="server">About</a></li>
                <li><a href="~/Rooms.aspx" runat="server">Rooms</a></li>
                <li><a href="~/Contact.aspx" runat="server">Contact</a></li>

                <asp:LoginView runat="server">
                    <AnonymousTemplate>
                        <%--<li><a href="~/Account/Register.aspx" runat="server">Register</a></li>--%>
                        <li><a class="nav-cta" href="~/Account/Login.aspx" runat="server">Log In</a></li>
                    </AnonymousTemplate>
                    <LoggedInTemplate>
                        <li><a href="~/Bookings/MyBookings.aspx" runat="server">My Bookings</a></li>
                        <li><a href="~/Account/Manage.aspx" runat="server">My Profile</a></li>
                        <asp:LoginView runat="server">
                            <RoleGroups>
                                <asp:RoleGroup Roles="Admin,Manager,Staff">
                                    <ContentTemplate>
                                        <li><a href="~/Private/Business%20Intelligence.aspx" runat="server">Dashboard</a></li>
                                        <li><a href="~/Private/Staff%20Management.aspx" runat="server">Staff</a></li>
                                        <li><a href="~/Private/Room%20Management.aspx" runat="server">Manage Rooms</a></li>
                                    </ContentTemplate>
                                </asp:RoleGroup>
                            </RoleGroups>
                        </asp:LoginView>
                       <li style="color:#fff; text-decoration:underline; opacity:1;">Hi, <asp:LoginName runat="server" /></li>
                        <li><asp:LoginStatus ID="LoginStatus1" runat="server" LogoutAction="Redirect" LogoutPageUrl="~/Default.aspx" LogoutText="Log out" OnLoggingOut="LoginStatus1_LoggingOut" /></li>
                    </LoggedInTemplate>
                </asp:LoginView>
            </ul>
        </nav>
        
       <!-- ================= SHOPPING CART WIDGET ================= -->
<div id="regal-cart-bubble" onclick="RegalCart.toggle()"
     style="position:fixed; bottom:24px; right:94px; z-index:2000; width:58px; height:58px; border-radius:50%; background:var(--blue-900); display:flex; align-items:center; justify-content:center; cursor:pointer; box-shadow:var(--shadow-lg); font-size:1.4rem;">
    🛒
    <span id="regal-cart-count" style="display:none; position:absolute; top:-4px; right:-4px; background:var(--accent); color:#fff; font-size:.7rem; font-weight:700; min-width:20px; height:20px; border-radius:10px; align-items:center; justify-content:center; padding:0 5px;">0</span>
</div>

<div id="regal-cart-window"
     style="display:none; flex-direction:column; position:fixed; bottom:94px; right:24px; z-index:2000; width:360px; max-width:90vw; max-height:70vh; background:#fff; border-radius:var(--radius-lg); border:1px solid var(--border); overflow:hidden; box-shadow:var(--shadow-lg);">
    <div style="background:var(--blue-900); color:#fff; padding:1rem; font-weight:700; display:flex; justify-content:space-between; align-items:center;">
        <span>Your Selected Rooms</span>
        <button type="button" onclick="RegalCart.toggle()" style="background:none; border:none; color:#fff; font-size:1.1rem; cursor:pointer; opacity:.85;">✕</button>
    </div>
    <div id="regal-cart-body" style="flex:1; padding:1rem; overflow-y:auto; display:flex; flex-direction:column; gap:.8rem;">
        <div class="cart-empty" style="text-align:center; color:var(--text-muted); padding:2rem 1rem; font-size:.9rem;">No rooms selected yet. Browse Rooms &amp; Rates to add some.</div>
    </div>
    <div id="regal-cart-footer" style="display:none; padding:1rem; border-top:1px solid var(--border); background:var(--blue-50);">
        <div style="display:flex; justify-content:space-between; font-weight:700; margin-bottom:.8rem; color:var(--text);">
            <span>Total</span>
            <span id="regal-cart-total"></span>
        </div>
       <a href="~/Payments.aspx" runat="server" class="btn-regal" style="width:100%; text-align:center; display:block;">Continue to Booking</a>
    </div>
   
</div>
         <asp:SqlDataSource ID="SqlDSInsertBooking" runat="server" ConflictDetection="CompareAllValues" ConnectionString="<%$ ConnectionStrings:ConnString %>" DeleteCommand="DELETE FROM [Booking] WHERE [Booking_ID] = @original_Booking_ID AND (([Client_ID] = @original_Client_ID) OR ([Client_ID] IS NULL AND @original_Client_ID IS NULL)) AND (([Branch_ID] = @original_Branch_ID) OR ([Branch_ID] IS NULL AND @original_Branch_ID IS NULL)) AND (([Booking_Date] = @original_Booking_Date) OR ([Booking_Date] IS NULL AND @original_Booking_Date IS NULL)) AND (([Checkin_Date] = @original_Checkin_Date) OR ([Checkin_Date] IS NULL AND @original_Checkin_Date IS NULL)) AND (([Checkout_Date] = @original_Checkout_Date) OR ([Checkout_Date] IS NULL AND @original_Checkout_Date IS NULL)) AND (([Booking_Total_Amount] = @original_Booking_Total_Amount) OR ([Booking_Total_Amount] IS NULL AND @original_Booking_Total_Amount IS NULL)) AND (([Booking_Status] = @original_Booking_Status) OR ([Booking_Status] IS NULL AND @original_Booking_Status IS NULL)) AND (([Cancellation_Date] = @original_Cancellation_Date) OR ([Cancellation_Date] IS NULL AND @original_Cancellation_Date IS NULL)) AND (([Cancellation_Reason] = @original_Cancellation_Reason) OR ([Cancellation_Reason] IS NULL AND @original_Cancellation_Reason IS NULL)) AND (([Admin_Notes] = @original_Admin_Notes) OR ([Admin_Notes] IS NULL AND @original_Admin_Notes IS NULL)) AND (([Number_Adults] = @original_Number_Adults) OR ([Number_Adults] IS NULL AND @original_Number_Adults IS NULL)) AND (([Number_Children] = @original_Number_Children) OR ([Number_Children] IS NULL AND @original_Number_Children IS NULL)) AND (([Booking_Type] = @original_Booking_Type) OR ([Booking_Type] IS NULL AND @original_Booking_Type IS NULL)) AND (([Penalty_Amount] = @original_Penalty_Amount) OR ([Penalty_Amount] IS NULL AND @original_Penalty_Amount IS NULL)) AND (([Credit_Amount] = @original_Credit_Amount) OR ([Credit_Amount] IS NULL AND @original_Credit_Amount IS NULL)) AND (([Staff_Created_By] = @original_Staff_Created_By) OR ([Staff_Created_By] IS NULL AND @original_Staff_Created_By IS NULL))" InsertCommand="INSERT INTO [Booking] ([Client_ID], [Branch_ID], [Booking_Date], [Checkin_Date], [Checkout_Date], [Booking_Total_Amount], [Booking_Status], [Cancellation_Date], [Cancellation_Reason], [Admin_Notes], [Number_Adults], [Number_Children], [Booking_Type], [Penalty_Amount], [Credit_Amount], [Staff_Created_By]) VALUES (@Client_ID, @Branch_ID, @Booking_Date, @Checkin_Date, @Checkout_Date, @Booking_Total_Amount, @Booking_Status, @Cancellation_Date, @Cancellation_Reason, @Admin_Notes, @Number_Adults, @Number_Children, @Booking_Type, @Penalty_Amount, @Credit_Amount, @Staff_Created_By)" OldValuesParameterFormatString="original_{0}" SelectCommand="SELECT * FROM [Booking]" UpdateCommand="UPDATE [Booking] SET [Client_ID] = @Client_ID, [Branch_ID] = @Branch_ID, [Booking_Date] = @Booking_Date, [Checkin_Date] = @Checkin_Date, [Checkout_Date] = @Checkout_Date, [Booking_Total_Amount] = @Booking_Total_Amount, [Booking_Status] = @Booking_Status, [Cancellation_Date] = @Cancellation_Date, [Cancellation_Reason] = @Cancellation_Reason, [Admin_Notes] = @Admin_Notes, [Number_Adults] = @Number_Adults, [Number_Children] = @Number_Children, [Booking_Type] = @Booking_Type, [Penalty_Amount] = @Penalty_Amount, [Credit_Amount] = @Credit_Amount, [Staff_Created_By] = @Staff_Created_By WHERE [Booking_ID] = @original_Booking_ID AND (([Client_ID] = @original_Client_ID) OR ([Client_ID] IS NULL AND @original_Client_ID IS NULL)) AND (([Branch_ID] = @original_Branch_ID) OR ([Branch_ID] IS NULL AND @original_Branch_ID IS NULL)) AND (([Booking_Date] = @original_Booking_Date) OR ([Booking_Date] IS NULL AND @original_Booking_Date IS NULL)) AND (([Checkin_Date] = @original_Checkin_Date) OR ([Checkin_Date] IS NULL AND @original_Checkin_Date IS NULL)) AND (([Checkout_Date] = @original_Checkout_Date) OR ([Checkout_Date] IS NULL AND @original_Checkout_Date IS NULL)) AND (([Booking_Total_Amount] = @original_Booking_Total_Amount) OR ([Booking_Total_Amount] IS NULL AND @original_Booking_Total_Amount IS NULL)) AND (([Booking_Status] = @original_Booking_Status) OR ([Booking_Status] IS NULL AND @original_Booking_Status IS NULL)) AND (([Cancellation_Date] = @original_Cancellation_Date) OR ([Cancellation_Date] IS NULL AND @original_Cancellation_Date IS NULL)) AND (([Cancellation_Reason] = @original_Cancellation_Reason) OR ([Cancellation_Reason] IS NULL AND @original_Cancellation_Reason IS NULL)) AND (([Admin_Notes] = @original_Admin_Notes) OR ([Admin_Notes] IS NULL AND @original_Admin_Notes IS NULL)) AND (([Number_Adults] = @original_Number_Adults) OR ([Number_Adults] IS NULL AND @original_Number_Adults IS NULL)) AND (([Number_Children] = @original_Number_Children) OR ([Number_Children] IS NULL AND @original_Number_Children IS NULL)) AND (([Booking_Type] = @original_Booking_Type) OR ([Booking_Type] IS NULL AND @original_Booking_Type IS NULL)) AND (([Penalty_Amount] = @original_Penalty_Amount) OR ([Penalty_Amount] IS NULL AND @original_Penalty_Amount IS NULL)) AND (([Credit_Amount] = @original_Credit_Amount) OR ([Credit_Amount] IS NULL AND @original_Credit_Amount IS NULL)) AND (([Staff_Created_By] = @original_Staff_Created_By) OR ([Staff_Created_By] IS NULL AND @original_Staff_Created_By IS NULL))">
             <DeleteParameters>
                 <asp:Parameter Name="original_Booking_ID" Type="Int32" />
                 <asp:Parameter Name="original_Client_ID" Type="Int32" />
                 <asp:Parameter Name="original_Branch_ID" Type="String" />
                 <asp:Parameter DbType="Date" Name="original_Booking_Date" />
                 <asp:Parameter DbType="Date" Name="original_Checkin_Date" />
                 <asp:Parameter DbType="Date" Name="original_Checkout_Date" />
                 <asp:Parameter Name="original_Booking_Total_Amount" Type="Decimal" />
                 <asp:Parameter Name="original_Booking_Status" Type="String" />
                 <asp:Parameter Name="original_Cancellation_Date" Type="DateTime" />
                 <asp:Parameter Name="original_Cancellation_Reason" Type="String" />
                 <asp:Parameter Name="original_Admin_Notes" Type="String" />
                 <asp:Parameter Name="original_Number_Adults" Type="Int32" />
                 <asp:Parameter Name="original_Number_Children" Type="Int32" />
                 <asp:Parameter Name="original_Booking_Type" Type="String" />
                 <asp:Parameter Name="original_Penalty_Amount" Type="Decimal" />
                 <asp:Parameter Name="original_Credit_Amount" Type="Decimal" />
                 <asp:Parameter Name="original_Staff_Created_By" Type="String" />
             </DeleteParameters>
             <InsertParameters>
                 <asp:Parameter Name="Client_ID" Type="Int32" />
                 <asp:Parameter Name="Branch_ID" Type="String" />
                 <asp:Parameter DbType="Date" Name="Booking_Date" />
                 <asp:Parameter DbType="Date" Name="Checkin_Date" />
                 <asp:Parameter DbType="Date" Name="Checkout_Date" />
                 <asp:Parameter Name="Booking_Total_Amount" Type="Decimal" />
                 <asp:Parameter Name="Booking_Status" Type="String" />
                 <asp:Parameter Name="Cancellation_Date" Type="DateTime" />
                 <asp:Parameter Name="Cancellation_Reason" Type="String" />
                 <asp:Parameter Name="Admin_Notes" Type="String" />
                 <asp:Parameter Name="Number_Adults" Type="Int32" />
                 <asp:Parameter Name="Number_Children" Type="Int32" />
                 <asp:Parameter Name="Booking_Type" Type="String" />
                 <asp:Parameter Name="Penalty_Amount" Type="Decimal" />
                 <asp:Parameter Name="Credit_Amount" Type="Decimal" />
                 <asp:Parameter Name="Staff_Created_By" Type="String" />
             </InsertParameters>
             <UpdateParameters>
                 <asp:Parameter Name="Client_ID" Type="Int32" />
                 <asp:Parameter Name="Branch_ID" Type="String" />
                 <asp:Parameter DbType="Date" Name="Booking_Date" />
                 <asp:Parameter DbType="Date" Name="Checkin_Date" />
                 <asp:Parameter DbType="Date" Name="Checkout_Date" />
                 <asp:Parameter Name="Booking_Total_Amount" Type="Decimal" />
                 <asp:Parameter Name="Booking_Status" Type="String" />
                 <asp:Parameter Name="Cancellation_Date" Type="DateTime" />
                 <asp:Parameter Name="Cancellation_Reason" Type="String" />
                 <asp:Parameter Name="Admin_Notes" Type="String" />
                 <asp:Parameter Name="Number_Adults" Type="Int32" />
                 <asp:Parameter Name="Number_Children" Type="Int32" />
                 <asp:Parameter Name="Booking_Type" Type="String" />
                 <asp:Parameter Name="Penalty_Amount" Type="Decimal" />
                 <asp:Parameter Name="Credit_Amount" Type="Decimal" />
                 <asp:Parameter Name="Staff_Created_By" Type="String" />
                 <asp:Parameter Name="original_Booking_ID" Type="Int32" />
                 <asp:Parameter Name="original_Client_ID" Type="Int32" />
                 <asp:Parameter Name="original_Branch_ID" Type="String" />
                 <asp:Parameter DbType="Date" Name="original_Booking_Date" />
                 <asp:Parameter DbType="Date" Name="original_Checkin_Date" />
                 <asp:Parameter DbType="Date" Name="original_Checkout_Date" />
                 <asp:Parameter Name="original_Booking_Total_Amount" Type="Decimal" />
                 <asp:Parameter Name="original_Booking_Status" Type="String" />
                 <asp:Parameter Name="original_Cancellation_Date" Type="DateTime" />
                 <asp:Parameter Name="original_Cancellation_Reason" Type="String" />
                 <asp:Parameter Name="original_Admin_Notes" Type="String" />
                 <asp:Parameter Name="original_Number_Adults" Type="Int32" />
                 <asp:Parameter Name="original_Number_Children" Type="Int32" />
                 <asp:Parameter Name="original_Booking_Type" Type="String" />
                 <asp:Parameter Name="original_Penalty_Amount" Type="Decimal" />
                 <asp:Parameter Name="original_Credit_Amount" Type="Decimal" />
                 <asp:Parameter Name="original_Staff_Created_By" Type="String" />
             </UpdateParameters>
        </asp:SqlDataSource>
        <!-- ================= PAGE CONTENT ================= -->
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />

        <!-- ================= PAGE CONTENT ================= -->
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />

        <!-- ================= FOOTER ================= -->
        <footer class="footer-regal">
            <div class="foot-links">
                <a href="~/Default.aspx" runat="server">Home</a>
                <a href="~/About.aspx" runat="server">About</a>
                <a href="~/Rooms.aspx" runat="server">Rooms &amp; Rates</a>
                <a href="~/Contact.aspx" runat="server">Contact</a>
            </div>
            <p>&copy; <%: DateTime.Now.Year %> The Regal Inn Hotel — Code Crafters Major Project</p>
        </footer>
    </form>

    <script src="<%= ResolveUrl("~/js/site-interactions.js") %>"></script>
    <script src="<%= ResolveUrl("~/js/chatbot-widget.js") %>"></script>
    <script src="<%= ResolveUrl("~/js/cart-widget.js") %>"></script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
</body>
</html>
